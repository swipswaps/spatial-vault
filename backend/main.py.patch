@app.get("/thumbnails/image/{filename:path}")
async def get_thumbnail(filename: str, folder: str = "./screenshots"):
    """Serve the actual image file with proper path handling."""
    # Decode URL-encoded filename
    import urllib.parse
    filename = urllib.parse.unquote(filename)
    file_path = os.path.join(folder, filename)
    if not os.path.exists(file_path):
        # Try alternative: check if file exists with original encoding
        raise HTTPException(status_code=404, detail="Image not found")
    return FileResponse(file_path, media_type="image/png")
